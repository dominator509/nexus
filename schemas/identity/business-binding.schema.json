{
  "$id": "https://schemas.nexus.local/business-binding/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_id": {
      "format": "uuid",
      "type": "string"
    },
    "person_id": {
      "format": "uuid",
      "type": "string"
    },
    "role": {
      "enum": [
        "OWNER",
        "ADMIN",
        "MEMBER",
        "CONTRACTOR",
        "VIEWER"
      ]
    },
    "tenant_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "person_id",
    "role",
    "tenant_id"
  ],
  "title": "BusinessBinding",
  "type": "object"
}
