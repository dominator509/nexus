{
  "$id": "https://schemas.nexus.local/event-envelope/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "data_class": {
      "enum": [
        "PUBLIC",
        "HOUSEHOLD",
        "PERSONAL",
        "SENSITIVE",
        "BUSINESS_CONFIDENTIAL",
        "SECURITY",
        "SECRET"
      ]
    },
    "event_id": {
      "format": "uuid",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$",
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "subject",
    "time",
    "tenant_id",
    "actor",
    "correlation_id",
    "data_class",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
