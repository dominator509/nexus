.DS_Store
Thumbs.db
*.log
# Closure/evidence attestation logs ARE canonical committed evidence:
# node-status-v2 validates the closure manifest's verify_log digest
# against the file on disk, so a fresh clone must reproduce them or
# node-DONE truth is unreachable there (AUD-090 fresh-clone ship run).
!.agent/remediation/evidence/*/verify.log
*.tmp
*.swp
terraform.tfstate
terraform.tfstate.*
.tofu/
crash.log
artifacts/local/
backups/local/
.agent/state/*.tmp
.agent/state/livefire/
!.agent/state/LEDGER.md

# TS emit artifacts alongside sources in the EP-035 live-fire/failure
# packages (generated by `pnpm -r build` before the outDir fix; builds
# now emit to gitignored dist/, these are regenerable strays kept on
# disk but out of the tree).
tests/livefire/deployment/src/__tests__/*.js
tests/livefire/deployment/src/__tests__/*.d.ts
tests/livefire/deployment/src/__tests__/*.js.map
tests/livefire/deployment/src/__tests__/*.d.ts.map
tests/onboarding/src/__tests__/*.js
tests/onboarding/src/__tests__/*.d.ts
tests/onboarding/src/__tests__/*.js.map
tests/onboarding/src/__tests__/*.d.ts.map

