# Nexus environment. Copy to .env and replace every REQUIRED value.
NEXUS_ENV=development
NEXUS_RELEASE_PROFILE=core
NEXUS_OWNER_EMAIL=owner@example.test
NEXUS_OWNER_DISPLAY_NAME=Nexus Owner
# Runtime smoke URL precedence (scripts/smoke/runtime.sh, LF-029):
#   1. NEXUS_SMOKE_URL wins when set (set this to your public domain or
#      dynamic IP when hosting remotely, e.g. NEXUS_SMOKE_URL=https://nexus.example.com)
#   2. NEXUS_BASE_DOMAIN is used only when it is a real deployable domain
#      (https://<domain>); local/test placeholders (.test/.local/.example.test/localhost) are ignored
#   3. Otherwise the canonical local mapping http://127.0.0.1:8443 is used
NEXUS_BASE_DOMAIN=nexus.example.test
NEXUS_BOOTSTRAP_AGE_KEY_FILE=./secrets/age-key.txt
NEXUS_KEYCLOAK_ADMIN_PASSWORD=replace-with-32-random-characters
NEXUS_POSTGRES_PASSWORD=replace-with-32-random-characters
NEXUS_OPENBAO_INIT_TOKEN=replace-with-one-time-bootstrap-token
DEEPSEEK_API_KEY=replace-with-deepseek-key
DOCKER_HOST=
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
HETZNER_API_TOKEN=
DIGITALOCEAN_TOKEN=
AWS_ACCESS_KEY_ID=
