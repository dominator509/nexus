{
  "realm": "nexus",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "defaultSignatureAlgorithm": "RS256",
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "nexus-admin",
        "description": "Canonical realm role required at the Nexus protected boundary"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nexus-app",
      "name": "Nexus application (human clients)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8477/callback"],
      "webOrigins": ["http://127.0.0.1:8477"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "nexus-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "included.client.audience": "nexus-app",
            "access.tokenResponse.claim": "false"
          }
        },
        {
          "name": "nexus-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "0190e1c4-5c8a-7f40-8a1b-2c3d4e5f6072",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nexus-scheduler",
      "name": "Nexus scheduler service identity",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "nexus-connector-runtime",
      "name": "Nexus connector runtime service identity",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "defaultDefaultClientScopes": [],
  "defaultOptionalClientScopes": []
}
