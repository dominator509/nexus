{
  "name": "@nexus/temporal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus Temporal engine adapter (SPEC-023, ADR-010). Implements the @nexus/workflows WorkflowContext port and the five workflow execute() contracts on Temporal TS SDK 1.17.2. Domain rules stay pure in src/state; engine bridges stay in src/.",
  "exports": {
    ".": "./src/index.ts"
  },
