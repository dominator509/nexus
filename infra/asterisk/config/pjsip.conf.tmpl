; ---- endpoint-x (wrong-credential probe target) -------------------
; A dedicated AOR that the M4 wrong-credential probe tries to register
; with a WRONG password: Asterisk's real digest challenge must deny it,
; leaving zero contacts for this AOR. A separate AOR makes denial
; unambiguous (an existing legit contact on the same AOR would mask
; the denial from the contact table).
[endpoint-x]
type=endpoint
context=internal
disallow=all
allow=ulaw
allow=alaw
allow=g722
allow=opus
auth=auth-x
aors=endpoint-x
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
identify_by=username

[endpoint-x]
type=aor
max_contacts=1
remove_existing=yes
minimum_expiration=3
default_expiration=30
maximum_expiration=60

[auth-x]
type=auth
auth_type=userpass
username=endpoint-x
password={{endpoint_x_password}}

; ---- endpoint-r (controlled 603 Decline responder) ----------------
; A dedicated AOR for the M4 REJECTED proof: the reject_endpoint.py
; fixture registers here with the real digest exchange, then answers
; every INVITE with 603 Decline. Asterisk maps 603 -> ChannelDestroyed
; cause 21 (Call Rejected), the typed REJECTED discriminator.
[endpoint-r]
type=endpoint
context=internal
disallow=all
allow=ulaw
allow=alaw
allow=g722
allow=opus
auth=auth-r
aors=endpoint-r
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
identify_by=username

[endpoint-r]
type=aor
max_contacts=1
remove_existing=yes
minimum_expiration=3
default_expiration=30
maximum_expiration=60

[auth-r]
type=auth
auth_type=userpass
username=endpoint-r
password={{endpoint_r_password}}

; ---- endpoint-s (controlled silent-media responder) ---------------
; A dedicated AOR for the M4 one-way media / mid-call media-loss
; proofs: the reject_endpoint.py fixture registers here and answers
; INVITEs with 200 OK (a=recvonly in silent mode: receives audio from
; the bridge but sends NO RTP back -> one-way media; sender mode:
; sends PCMU silence for a bounded window then goes silent -> mid-call
; media loss). The production bridge stays real; only this peer is a
; fixture.
[endpoint-s]
type=endpoint
context=internal
disallow=all
allow=ulaw
allow=alaw
allow=g722
allow=opus
auth=auth-s
aors=endpoint-s
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
identify_by=username

[endpoint-s]
type=aor
max_contacts=1
remove_existing=yes
minimum_expiration=3
default_expiration=30
maximum_expiration=60

[auth-s]
type=auth
auth_type=userpass
username=endpoint-s
password={{endpoint_s_password}}

